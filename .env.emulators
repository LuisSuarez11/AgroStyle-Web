# Desarrollo local seguro con Firebase Emulator Suite.
# Usar con: npm run dev:emulators
# Este archivo NO apunta a Firebase Cloud real.
VITE_FIREBASE_TARGET=emulators
VITE_USE_FIREBASE_EMULATORS=true

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-agrostyle.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-agrostyle
VITE_FIREBASE_STORAGE_BUCKET=demo-agrostyle.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=demo-sender
VITE_FIREBASE_APP_ID=demo-app

VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001