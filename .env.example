# Supabase (backend actual - conservar durante la migracion a Firebase)
# Settings -> API en tu proyecto: https://supabase.com
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Nombre del bucket publico que creaste (opcional, default 'agrostyle')
VITE_SUPABASE_BUCKET=agrostyle

# Firebase (backend definitivo)
# Flujo local seguro: usa `npm run dev:emulators` + `npm run emulators`.
# El modo emuladores usa proyecto demo-agrostyle por defecto (sin cloud real).
VITE_FIREBASE_TARGET=emulators
VITE_USE_FIREBASE_EMULATORS=true

# Configuracion cloud REAL (solo uso explicito/autorizado, no para pruebas locales).
# Para usar cloud en desarrollo: VITE_FIREBASE_TARGET=cloud y VITE_USE_FIREBASE_EMULATORS=false.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=agrostyle-436b8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agrostyle-436b8
VITE_FIREBASE_STORAGE_BUCKET=agrostyle-436b8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Emuladores locales
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001
