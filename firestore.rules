rules_version = '2';

// LOCAL EMULATOR ONLY - DO NOT DEPLOY.
// F2: reglas restrictivas para validacion aislada de Auth/Perfil en Emulator Suite.
// Cualquier despliegue requiere revision de seguridad, aprobacion y plan de rollout.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidPublicRole(role) {
      return role in ['buyer', 'producer', 'transporter'];
    }

    function isValidApprovalStatus(status) {
      return status in ['pending', 'approved', 'rejected'];
    }

    function isValidAccountStatus(status) {
      return status in ['active', 'disabled'];
    }

    function hasAllowedCreateKeys() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'fullName',
        'role',
        'approvalStatus',
        'accountStatus',
        'profileVersion',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasAllowedProfileKeys() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'fullName',
        'role',
        'approvalStatus',
        'accountStatus',
        'profileVersion',
        'createdAt',
        'updatedAt'
      ]);
    }

    function emailMatchesAuthToken() {
      return !('email' in request.auth.token)
        || request.resource.data.email == request.auth.token.email;
    }

    function validInitialStateByRole() {
      return (request.resource.data.role == 'buyer'
          && request.resource.data.approvalStatus == 'approved'
          && request.resource.data.accountStatus == 'active')
        || (request.resource.data.role in ['producer', 'transporter']
          && request.resource.data.approvalStatus == 'pending'
          && request.resource.data.accountStatus == 'active');
    }

    function ownerEditableKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'fullName',
        'updatedAt'
      ]);
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && hasAllowedCreateKeys()
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && isValidPublicRole(request.resource.data.role)
        && isValidApprovalStatus(request.resource.data.approvalStatus)
        && isValidAccountStatus(request.resource.data.accountStatus)
        && validInitialStateByRole()
        && request.resource.data.profileVersion == 1
        && emailMatchesAuthToken();

      allow get: if isOwner(uid);
      allow list: if false;

      allow update: if isOwner(uid)
        && hasAllowedProfileKeys()
        && ownerEditableKeysOnly()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.profileVersion == resource.data.profileVersion
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
