{
  "name": "agrostyle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-agrostyle",
    "emulators:export": "firebase emulators:start --only auth,firestore,storage --project demo-agrostyle --import ./.emulator-data --export-on-exit ./.emulator-data",
    "test:f2:rules": "node scripts/firebase/f2-rules-and-auth-smoke.mjs",
    "seed:admin:emulator": "node scripts/firebase/seed-admin.emulator.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "verify:f3": "node scripts/f3-verification.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "firebase": "^11.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "globals": "^17.5.0",
    "jsdom": "^31.0.1",
    "vite": "^8.0.10",
    "vitest": "^5.1.2"
  }
}
