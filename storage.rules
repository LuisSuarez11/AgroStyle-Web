rules_version = '2';

// LOCAL EMULATOR ONLY - DO NOT DEPLOY.
// Archivo preexistente en el proyecto. Se usa como regla local para emuladores en F1.
// Las reglas definitivas de Storage deben revisarse/aprobarse antes de cualquier despliegue.
service firebase.storage {
  match /b/{bucket}/o {

    // Documentos subidos por el productor (solo dueño puede escribir, todos los autenticados leen)
    match /documents/{uid}/{file=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Imagenes de productos: solo el productor dueno puede escribir; cualquiera autenticado lee
    match /products/{uid}/{file=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
